# ============================================================
# AgriFarm Backend — Environment Configuration Template
# ============================================================

# ── Server Config ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# ── MariaDB / MySQL Database ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=agrifarm
DB_CONNECTION_LIMIT=10

# ── JWT Security Secrets ──────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Initial Admin Credentials ─────────────────────────────────
ADMIN_EMAIL=admin@agrifarm.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ── Email / SMTP Settings ─────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="AgriFarm Support <no-reply@agrifarm.com>"

# ── Upload & Storage Settings ─────────────────────────────────
UPLOAD_DIR=public/images
MAX_FILE_SIZE=5242880

# ── CORS Origins ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://10.0.2.2:3000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=100
