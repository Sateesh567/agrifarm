# ============================================================
# AgriFarm Backend — Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to ".env"
#   2. Fill in the values for your environment
#   3. NEVER commit the actual ".env" file to Git
#   4. This ".env.example" file IS safe to commit (no real secrets)
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV options: development | production

# ── MySQL Database ────────────────────────────────────────────
# For local XAMPP:   DB_HOST=127.0.0.1
# For remote server: DB_HOST=your-db-server-ip-or-hostname
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=agrifarm
DB_CONNECTION_LIMIT=10

# ── JWT Secrets ───────────────────────────────────────────────
# IMPORTANT: Change these to long random strings in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS Origins ──────────────────────────────────────────────
# Development (local):
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example (replace with your actual domain):
# CORS_ORIGINS=https://agrifarm-admin.yourdomain.com,https://api.yourdomain.com

# ── Rate Limiting ─────────────────────────────────────────────
# Development: high limits for testing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
LOGIN_RATE_LIMIT_MAX=10000
# Production: tighten these
# RATE_LIMIT_MAX=200
# LOGIN_RATE_LIMIT_MAX=20
