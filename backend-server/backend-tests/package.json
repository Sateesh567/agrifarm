{
  "name": "agrifarm-backend-tests",
  "version": "1.0.0",
  "description": "Enterprise-grade automated test framework for AgriFarm Backend APIs",
  "main": "scripts/run-tests.js",
  "type": "module",
  "scripts": {
    "seed-excel": "node utils/excelGenerator.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --forceExit",
    "test:all": "npm run seed-excel && npm run test"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "newman": "^6.1.3",
    "supertest": "^7.0.0"
  }
}
