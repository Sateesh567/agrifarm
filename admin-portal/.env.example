# ============================================================
# AgriFarm Admin Portal — Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to ".env"
#   2. Fill in the values for your environment
#   3. NEVER commit the actual ".env" file to Git
#   4. This ".env.example" file IS safe to commit
# ============================================================

# ── Backend API URL ───────────────────────────────────────────
# Development (local machine):
VITE_API_BASE_URL=http://localhost:3000

# Production example (replace with your deployed server URL):
# VITE_API_BASE_URL=https://api.agrifarm.yourdomain.com

# ── App Info ──────────────────────────────────────────────────
VITE_APP_NAME=AgriFarm Admin Portal
VITE_APP_VERSION=2.0
